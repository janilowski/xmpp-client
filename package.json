{
  "name": "@janilowski/xmpp-client",
  "version": "0.0.1",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./types/index.d.ts",
  "license": "ISC",
  "repository": {
    "url": "https://github.com/janilowski/xmpp-client"
  },
  "files": [
    "dist",
    "types",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "description": "An XMPP client library for the modern web.",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "bytes": "^3.1.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-n": "^18.4.1",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-unicorn": "^77.0.0",
    "fast-check": "4.10.2",
    "globals": "^17.13.0",
    "lint-staged": "^17.6.0",
    "playwright": "1.64.0",
    "prettier": "^3.9.10",
    "rolldown": "^1.2.13",
    "selfsigned": "^5.5.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.1"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./xml": {
      "types": "./types/xml.d.ts",
      "import": "./dist/xml.js",
      "default": "./dist/xml.js"
    },
    "./xml/jsx-runtime": {
      "types": "./types/jsx-runtime.d.ts",
      "import": "./dist/xml/jsx-runtime.js",
      "default": "./dist/xml/jsx-runtime.js"
    },
    "./xml/jsx-dev-runtime": {
      "types": "./types/jsx-dev-runtime.d.ts",
      "import": "./dist/xml/jsx-dev-runtime.js",
      "default": "./dist/xml/jsx-dev-runtime.js"
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#xml": "./src/xml/index.js",
    "#xml/jsx-runtime": "./src/xml/jsx-runtime.js",
    "#xml/jsx-dev-runtime": "./src/xml/jsx-dev-runtime.js"
  },
  "engines": {
    "node": ">= 22.11"
  },
  "lint-staged": {
    "*.{js,ts,mjs}": "eslint --cache --fix",
    "*.{json,md,html,css,yaml,yml}": "prettier --write"
  },
  "scripts": {
    "test:unit": "bun test src server/fixture.test.js server/readiness.test.js ./src/sasl2/test.js ./src/sasl/test.js ./src/resource-binding/test.js ./src/reconnect/test.js ./src/debug/test.js ./src/error/test.js ./src/client/test.js",
    "test:conformance": "bun conformance/run.ts",
    "test:mutations": "bun conformance/mutations.ts",
    "test": "bun run test:unit",
    "test:e2e": "bun test/integration.js e2e",
    "test:browser": "bun run build && bun test ./test/bundle.test.js && bun test/integration.js browser",
    "prosody:setup": "bun server/setup.js",
    "server:start": "bun server/ctl.js start",
    "server:stop": "bun server/ctl.js stop",
    "server:restart": "bun server/ctl.js restart",
    "bundlesize": "bun test/bundlesize.js",
    "size": "bun run build && bun run bundlesize",
    "test:static": "bun run test:unit && bun run lint && bun run typecheck && bun run build && bun run bundlesize",
    "test:all": "bun run test:static && bun run test:conformance && bun run test:mutations && bun run test:e2e && bun run test:browser",
    "ci": "bun install --frozen-lockfile && bun run prosody:setup && bun run test:all",
    "clean": "bun run server:stop ; rm -f server/localhost.key server/localhost.crt server/prosody.err server/prosody.log server/prosody.pid lerna-debug.log ; rm -rf server/modules server/.cache node_modules dist",
    "preversion": "bun run build",
    "typecheck": "tsc --noEmit && tsc --project test/tsconfig.public.json",
    "build": "rolldown -c",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache --fix ."
  },
  "type": "module",
  "sideEffects": false,
  "packageManager": "bun@1.4.3",
  "overrides": {
    "brace-expansion": "5.0.12",
    "flatted": "3.4.4",
    "picomatch": "4.0.7"
  },
  "dependencies": {
    "events": "^3.3.0",
    "ltx": "^3.1.2",
    "punycode": "2.3.1",
    "saxes": "6.0.0"
  },
  "patchedDependencies": {
    "ltx@3.1.2": "patches/ltx@3.1.2.patch"
  }
}
